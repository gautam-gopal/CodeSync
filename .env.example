# Local-only development. Copy to .env and replace the password and JWT secret.
MONGO_ROOT_USERNAME=codesync_dev
MONGO_ROOT_PASSWORD=replace-with-a-random-alphanumeric-password
MONGODB_URI=mongodb://codesync_dev:replace-with-a-random-alphanumeric-password@127.0.0.1:27019/?authSource=admin
MONGODB_DATABASE=codesync_dev
MONGODB_COLLECTION=documents

# Generate a unique secret with at least 32 random bytes. Leave blank until set.
JWT_SECRET=

# Hocuspocus collaboration service (local only while M1 membership authorization is absent).
HOST=127.0.0.1
PORT=1234
PERSISTENCE_DEBOUNCE_MS=250
PERSISTENCE_MAX_DEBOUNCE_MS=1000

# Express authentication API, implemented in the next M1 step.
API_PORT=3000
ACCESS_TOKEN_TTL=15m
